{
  "name": "openclaw-render",
  "version": "2.0.0",
  "private": true,
  "description": "OpenClaw on Render — one-click deploy, powered by alphaclaw (garrytan/alphaclaw)",
  "scripts": {
    "dev": "docker compose up --build",
    "dev:stop": "docker compose down",
    "dev:clean": "docker compose down -v",
    "dev:logs": "docker compose logs -f",
    "dev:shell": "docker compose exec openclaw bash",
    "test": "npm run test:unit && npm run test:contract",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:contract": "bats tests/contract/",
    "test:e2e": "bats tests/e2e/",
    "test:all": "npm run test && npm run test:e2e"
  },
  "dependencies": {
    "alphaclaw": "git+https://github.com/garrytan/alphaclaw.git#ff23cfda9f2b97a980b9632783c4cf21e2e7ebe9"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
